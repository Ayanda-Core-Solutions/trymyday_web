{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Web",
      "type": "shell",
      "command": "flutter",
      "args": ["build", "web"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Serve build/web",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "http.server", "8080"],
      "options": {
        "cwd": "${workspaceFolder}/build/web"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Build and Serve Web",
      "dependsOrder": "sequence",
      "dependsOn": ["Build Web", "Serve build/web"],
      "problemMatcher": []
    }
  ]
}
